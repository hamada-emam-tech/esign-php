# Copy to .env.sandbox (gitignored) to run: vendor/bin/phpunit --group live
SADQ_BASE_URL=https://api-sandbox.sadq-sa.com
SADQ_CLIENT_ID=Integrationclient
SADQ_CLIENT_SECRET=
SADQ_ACCOUNT_ID=
SADQ_ACCOUNT_SECRET=
SADQ_USERNAME=
SADQ_PASSWORD=
# Where invitation emails go during live tests
SADQ_TEST_EMAIL=
# A NON-default webhook registered for testing, so test envelopes don't notify anyone else
SADQ_WEBHOOK_ID=
# Optional: an envelope you signed by hand, to test download()
SADQ_SIGNED_ENVELOPE=
