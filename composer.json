{
    "name": "hamada-emam-tech/esign-monorepo",
    "description": "Monorepo for hamada-emam-tech/esign and its provider packages. Each folder in packages/ is split into its own read-only repo and published on Packagist.",
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "^8.2",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^1.10"
    },
    "autoload": {
        "psr-4": { "HamadaEmamTech\\Esign\\": "packages/esign/src/" }
    },
    "autoload-dev": {
        "psr-4": { "HamadaEmamTech\\Esign\\Tests\\": "packages/esign/tests/" }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --level=8 packages"
    },
    "config": { "sort-packages": true }
}
