{
    "name": "hamada-emam-tech/esign-monorepo",
    "description": "Monorepo for hamada-emam-tech/esign and its provider packages. Each folder in packages/ is split into its own read-only repo and published on Packagist.",
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/simple-cache": "^1.0 || ^2.0 || ^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^1.10",
        "guzzlehttp/guzzle": "^7.8"
    },
    "autoload": {
        "psr-4": {
            "HamadaEmamTech\\Esign\\": "packages/esign/src/",
            "HamadaEmamTech\\Esign\\Sadq\\": "packages/esign-sadq/src/",
            "HamadaEmamTech\\Esign\\DocuSign\\": "packages/esign-docusign/src/",
            "HamadaEmamTech\\Esign\\Zoho\\": "packages/esign-zoho/src/",
            "HamadaEmamTech\\Esign\\Dropbox\\": "packages/esign-dropbox/src/",
            "HamadaEmamTech\\Esign\\BoldSign\\": "packages/esign-boldsign/src/",
            "HamadaEmamTech\\Esign\\Adobe\\": "packages/esign-adobe/src/",
            "HamadaEmamTech\\Esign\\UaePass\\": "packages/esign-uaepass/src/",
            "HamadaEmamTech\\Esign\\Signit\\": "packages/esign-signit/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "HamadaEmamTech\\Esign\\Tests\\": "packages/esign/tests/",
            "HamadaEmamTech\\Esign\\Sadq\\Tests\\": "packages/esign-sadq/tests/",
            "HamadaEmamTech\\Esign\\DocuSign\\Tests\\": "packages/esign-docusign/tests/",
            "HamadaEmamTech\\Esign\\Zoho\\Tests\\": "packages/esign-zoho/tests/",
            "HamadaEmamTech\\Esign\\Dropbox\\Tests\\": "packages/esign-dropbox/tests/",
            "HamadaEmamTech\\Esign\\BoldSign\\Tests\\": "packages/esign-boldsign/tests/",
            "HamadaEmamTech\\Esign\\Adobe\\Tests\\": "packages/esign-adobe/tests/",
            "HamadaEmamTech\\Esign\\UaePass\\Tests\\": "packages/esign-uaepass/tests/",
            "HamadaEmamTech\\Esign\\Monorepo\\Tests\\": "tests/",
            "HamadaEmamTech\\Esign\\Signit\\Tests\\": "packages/esign-signit/tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse"
    },
    "config": {
        "sort-packages": true
    },
    "bin": [
        "packages/esign/bin/esign"
    ]
}
