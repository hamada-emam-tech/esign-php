{
    "name": "hamada-emam-tech/esign-adobe",
    "description": "Adobe Acrobat Sign (REST API v6) driver for hamada-emam-tech/esign: agreements, signature fields, webhooks.",
    "keywords": ["esign", "e-signature", "adobe", "acrobat-sign", "adobe-sign"],
    "license": "MIT",
    "type": "library",
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "hamada-emam-tech/esign": "^0.3",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/simple-cache": "^1.0 || ^2.0 || ^3.0"
    },
    "suggest": {
        "guzzlehttp/guzzle": "A PSR-18 HTTP client, picked up automatically",
        "symfony/http-client": "A PSR-18 HTTP client, picked up automatically"
    },
    "autoload": {
        "psr-4": { "HamadaEmamTech\\Esign\\Adobe\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "HamadaEmamTech\\Esign\\Adobe\\Tests\\": "tests/" }
    },
    "extra": {
        "esign": { "providers": { "adobe": "HamadaEmamTech\\Esign\\Adobe\\AdobeFactory" } }
    },
    "minimum-stability": "stable"
}
