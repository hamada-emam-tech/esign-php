{
    "name": "hamada-emam-tech/esign-docusign",
    "description": "DocuSign eSignature REST API v2.1 driver for hamada-emam-tech/esign: JWT Grant, envelopes, Connect webhooks with HMAC.",
    "keywords": ["esign", "e-signature", "docusign", "envelope", "webhook"],
    "license": "MIT",
    "type": "library",
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "ext-openssl": "*",
        "hamada-emam-tech/esign": "^0.3",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/simple-cache": "^1.0 || ^2.0 || ^3.0"
    },
    "suggest": {
        "guzzlehttp/guzzle": "A PSR-18 HTTP client, picked up automatically",
        "symfony/http-client": "A PSR-18 HTTP client, picked up automatically"
    },
    "autoload": {
        "psr-4": { "HamadaEmamTech\\Esign\\DocuSign\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "HamadaEmamTech\\Esign\\DocuSign\\Tests\\": "tests/" }
    },
    "extra": {
        "esign": { "providers": { "docusign": "HamadaEmamTech\\Esign\\DocuSign\\DocuSignFactory" } }
    },
    "minimum-stability": "stable"
}
